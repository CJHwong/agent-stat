set-option -g @window_sidebar_enabled 0
set-option -g @window_sidebar_shared @SHARED_DEFAULT@
set-option -g mouse on
set-option -g status off
set-option -s escape-time 20
set-option -g pane-active-border-style fg=colour240,bg=default
set-option -g pane-border-status top
set-option -g @window_sidebar_focus_zoom 1
set-option -g pane-border-format "#{?pane_active,#[bold],} #{?#{&&:#{@window_sidebar_enabled},#{&&:#{==:#{pane_top},1},#{==:#{e|+:#{pane_left},#{pane_width}},#{window_width}}}},#{?#{>:#{pane_width},24},#{=#{e|-:#{pane_width},24}:pane_title} ,}#[align=right]#{?#{>=:#{pane_width},20},[Auto zoom: #{?#{==:#{@window_sidebar_focus_zoom},0},off,on}] ,Zoom:#{?#{==:#{@window_sidebar_focus_zoom},0},off,on}},#{pane_title} }"
if-shell -F '#{==:#{default-command},}' { set-option -g default-command "@SIDEBAR_COMMAND@ shell" }
bind-key -N 'Toggle sidebar' Tab run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' toggle"
set-hook -g after-new-window[91] { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' ensure" }
set-hook -g pane-exited[91] { if-shell -F '#{==:#{window_panes},1}' { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' ensure" } }
set-hook -g client-attached[91] { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' attach" }
set-hook -g after-new-session[91] { if-shell -F '#{session_attached}' { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' attach" } }
set-hook -g client-resized[91] { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' ensure" }
set-hook -g after-resize-window[91] { if-shell -F '#{!=:#{@window_sidebar_resizing},1}' { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' ensure" } }
set-hook -g after-select-window[91] { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' ensure" }
set-hook -g after-select-window[92] {
    if-shell -F '#{@window_sidebar_pane}' { run-shell -b "tmux -S '#{socket_path}' send-keys -t '#{@window_sidebar_pane}' F12" }
}
set-hook -g window-pane-changed[93] { if-shell -F '#{&&:#{@window_sidebar_enabled},#{&&:#{>:#{window_panes},2},#{&&:#{==:#{@window_sidebar},},#{!=:#{@window_sidebar_focus_zoom},0}}}}' { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --pane '#{pane_id}' focus" } }
set-hook -g after-split-window[93] { if-shell -F '#{&&:#{@window_sidebar_enabled},#{!=:#{@window_sidebar_focus_zoom},0}}' { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --pane '#{pane_id}' focus" } }
set-hook -g after-select-window[93] { if-shell -F '#{&&:#{@window_sidebar_enabled},#{&&:#{>:#{window_panes},2},#{!=:#{@window_sidebar_focus_zoom},0}}}' { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --pane '#{pane_id}' focus" } }
set-hook -g after-resize-pane[93] { if-shell -F '#{&&:#{@window_sidebar_enabled},#{&&:#{==:#{@window_sidebar_focus_zoom},0},#{&&:#{@window_sidebar_focus_layout},#{==:#{window_zoomed_flag},0}}}}' { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --pane '#{pane_id}' focus" } }
bind-key -n -N 'Toggle auto zoom at top-right border' MouseUp1Border if-shell -F -t = '#{&&:#{@window_sidebar_enabled},#{&&:#{==:#{@window_sidebar},},#{&&:#{==:#{pane_top},1},#{==:#{e|+:#{pane_left},#{pane_width}},#{window_width}}}}}' { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --pane '#{mouse_pane}' focus-toggle" }
bind-key -n -N 'Pane menu' MouseDown3Pane if-shell -F -t = '#{@window_sidebar}' { send-keys -M -t = } { run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --client '#{client_name}' --pane '#{mouse_pane}' menu" }
bind-key -n -N 'Pane menu' F1 run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --client '#{client_name}' --pane '#{pane_id}' menu"
bind-key -N 'Search windows and panes' / run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --client '#{client_name}' search"
bind-key -N 'Recover saved work' r run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --client '#{client_name}' recover"
bind-key -N 'View full command' f run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --client '#{client_name}' --pane '#{pane_id}' command"
bind-key -N 'Toggle full zoom' z run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --pane '#{pane_id}' zoom"
bind-key -N 'Show shortcuts' ? run-shell -b "@SIDEBAR_COMMAND@ --socket '#{socket_path}' --session '#{session_id}' --client '#{client_name}' keys"
